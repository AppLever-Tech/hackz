# Control Plane Firebase project (Hackz platform).
HACKZ_CONTROL_PLANE_PROJECT_ID=hackz-a17b6

# Local only. Cloud Run uses Application Default Credentials from the
# attached hackz-provisioning runtime service account. Do not bake a key
# into the container image and do not set this on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=./hackz-provisioning-sa.json

# Local listen port. Cloud Run injects PORT; that takes precedence.
HACKZ_PROVISIONING_PORT=8787
HACKZ_CORS_ORIGIN=*
