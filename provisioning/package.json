{
  "name": "hackz-tenant-provisioning",
  "version": "1.0.0",
  "private": true,
  "description": "Control Plane job that provisions the first College Admin on a tenant Firebase project.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "provision-admin": "tsx src/cli.ts",
    "serve": "tsx --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test src/phone.test.ts src/validate.test.ts src/event-entitlement.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
