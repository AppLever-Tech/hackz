rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Auth mirror: links Firebase Auth UID → hkzUsers/{linkedProfileId} (written from app after sign-in)
    function authMirrorExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/hkzUserAuthMirror/$(request.auth.uid));
    }

    function authMirror() {
      return get(/databases/$(database)/documents/hkzUserAuthMirror/$(request.auth.uid)).data;
    }

    function profileExists() {
      return authMirrorExists()
        && authMirror().keys().hasAll(['linkedProfileId'])
        && exists(/databases/$(database)/documents/hkzUsers/$(authMirror().linkedProfileId));
    }

    function authProfile() {
      return get(/databases/$(database)/documents/hkzUsers/$(authMirror().linkedProfileId)).data;
    }

    function mirrorLinked() {
      return request.auth != null
        && authMirrorExists()
        && profileExists();
    }

    function phoneMatchesProfile() {
      return mirrorLinked()
        && request.auth.token.phone_number == authProfile().phone;
    }

    function isCoordinator() {
      return mirrorLinked()
        && phoneMatchesProfile()
        && authProfile().role == 'COO'
        && authProfile().isActive == true;
    }

    function isStudentOrFaculty() {
      return mirrorLinked()
        && phoneMatchesProfile()
        && authProfile().isActive == true
        && (authProfile().role == 'STU' || authProfile().role == 'FAC');
    }

    function ideaData(ideaId) {
      return get(/databases/$(database)/documents/hkzIdeas/$(ideaId)).data;
    }

    function teamData(teamId) {
      return get(/databases/$(database)/documents/hkzTeams/$(teamId)).data;
    }

    function payerOnTeam(paidBy, teamId) {
      let t = teamData(teamId);
      return paidBy == t.facultyId
        || paidBy in t.studentIds;
    }

    function paymentPayloadMatchesIdea(data, ideaId) {
      let idea = ideaData(ideaId);
      return data.ideaId == ideaId
        && data.teamId == idea.teamId
        && data.orgId == idea.orgId
        && data.departmentCode == idea.departmentCode
        && data.problemId == idea.problemId;
    }

    function coordinatorOrgDeptMatchesPayment(data) {
      return authProfile().orgId == data.orgId
        && authProfile().departmentCode == data.departmentCode;
    }

    match /hkzUserAuthMirror/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['linkedProfileId'])
        && request.resource.data.linkedProfileId is string
        && exists(/databases/$(database)/documents/hkzUsers/$(request.resource.data.linkedProfileId))
        && get(/databases/$(database)/documents/hkzUsers/$(request.resource.data.linkedProfileId)).data.phone
          == request.auth.token.phone_number;
      allow delete: if false;
    }

    match /hkzPayments/{paymentDocId} {
      allow read: if request.auth != null
        && (
          (resource.data.uploadedByAuthUid == request.auth.uid)
          || (isCoordinator() && coordinatorOrgDeptMatchesPayment(resource.data))
        );

      allow create: if request.auth != null
        && paymentDocId == request.resource.data.ideaId
        && request.resource.data.ideaId == paymentDocId
        && request.resource.data.status == 'pending'
        && request.resource.data.uploadedByAuthUid == request.auth.uid
        && request.resource.data.verifiedBy == ''
        && request.resource.data.remarks == ''
        && isStudentOrFaculty()
        && exists(/databases/$(database)/documents/hkzIdeas/$(paymentDocId))
        && ideaData(paymentDocId).status == 'pendingSubmission'
        && paymentPayloadMatchesIdea(request.resource.data, paymentDocId)
        && authProfile().orgId == request.resource.data.orgId
        && payerOnTeam(request.resource.data.paidByStudentId, request.resource.data.teamId);

      allow update: if request.auth != null && resource.data.ideaId == request.resource.data.ideaId
        && (
          (
            isStudentOrFaculty()
            && authProfile().orgId == resource.data.orgId
            && request.resource.data.uploadedByAuthUid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['amount', 'paymentProofUrl', 'paidByStudentId', 'status', 'verifiedBy',
                'verifiedAt', 'remarks', 'createdAt', 'transactionId', 'uploadedByAuthUid', 'paymentId'])
            && payerOnTeam(request.resource.data.paidByStudentId, request.resource.data.teamId)
            && paymentPayloadMatchesIdea(request.resource.data, resource.data.ideaId)
          )
          || (
            isCoordinator()
            && coordinatorOrgDeptMatchesPayment(resource.data)
            && resource.data.status == 'pending'
            && (request.resource.data.status == 'verified' || request.resource.data.status == 'rejected')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'verifiedBy', 'verifiedAt', 'remarks', 'paymentId'])
          )
        );

      allow delete: if false;
    }

    match /hkzIdeas/{ideaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if request.auth != null && (
        !(resource.data.status == 'pendingSubmission' && request.resource.data.status == 'submitted')
        || (
          isCoordinator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && exists(/databases/$(database)/documents/hkzPayments/$(ideaId))
          && get(/databases/$(database)/documents/hkzPayments/$(ideaId)).data.status == 'verified'
        )
      );
    }

    match /hkzUsers/{userId} {
      allow read, write: if request.auth != null;
    }

    match /hkzOrganizations/{orgId} {
      allow read, write: if request.auth != null;
    }

    match /hkzSysAdminWhitelist/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hkzAccessCodes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hkzCounters/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hkzScores/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hkzDepartments/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hkzProblems/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hkzTeams/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
